<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl"
       version="1.0"
       class="in-text"
       default-locale="pt-BR">

  <info>
    <category citation-format="author-date"/>
    <id>https://raw.githubusercontent.com/NathalyFugikawa/abnt-nbr-6023-2025-mendeley/main/abnt_nbr_6023_2025_mendeley_ajustado.csl</id>
    <link href="https://raw.githubusercontent.com/NathalyFugikawa/abnt-nbr-6023-2025-mendeley/main/abnt_nbr_6023_2025_mendeley_ajustado.csl"
          rel="self"/>
    <rights license="https://creativecommons.org/licenses/by-sa/4.0/">
      Creative Commons Attribution-ShareAlike 4.0 International
    </rights>
    <summary>
      Estilo CSL em português do Brasil baseado na ABNT NBR 6023 para referências.
    </summary>
    <title>ABNT NBR 6023 — Mendeley Ajustado</title>
    <title-short>ABNT Mendeley</title-short>
    <updated>2026-09-26T10:00:00-03:00</updated>
  </info>

  <locale xml:lang="pt-BR">
    <terms>
      <term name="and">e</term>
      <term name="et-al">et al.</term>
      <term name="page">p.</term>
      <term name="section">seção</term>
      <term name="chapter">cap.</term>
      <term name="volume">v.</term>
      <term name="issue">n.</term>
      <term name="edition">ed.</term>
      <term name="accessed">Acesso em:</term>
      <term name="page-range-delimiter">-</term>
      <term name="month-01">jan.</term>
      <term name="month-02">fev.</term>
      <term name="month-03">mar.</term>
      <term name="month-04">abr.</term>
      <term name="month-05">maio</term>
      <term name="month-06">jun.</term>
      <term name="month-07">jul.</term>
      <term name="month-08">ago.</term>
      <term name="month-09">set.</term>
      <term name="month-10">out.</term>
      <term name="month-11">nov.</term>
      <term name="month-12">dez.</term>
    </terms>
  </locale>

  <!-- =========================
       AUTORES
       ========================= -->

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all"
            sort-separator=", "
            initialize-with=". "
            delimiter="; "
            delimiter-precedes-last="always"
            delimiter-precedes-et-al="always"
            et-al-min="2"
            et-al-use-first="1"/>
      <et-al font-style="italic"/>
      <substitute>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="author-citation">
    <names variable="author">
      <name name-as-sort-order="all"
            sort-separator=", "
            initialize-with=". "
            delimiter="; "
            delimiter-precedes-last="always"
            et-al-min="2"
            et-al-use-first="1"/>
      <et-al font-style="italic"/>
      <substitute>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="editor">
    <names variable="editor">
      <name name-as-sort-order="all"
            sort-separator=", "
            initialize-with=". "
            delimiter="; "
            delimiter-precedes-last="always"/>
      <label prefix=" (" suffix=")" form="short"/>
    </names>
  </macro>

  <!-- =========================
       TÍTULO / EDIÇÃO
       ========================= -->

  <macro name="title">
    <text variable="title" font-weight="bold"/>
  </macro>

  <macro name="title-normal">
    <text variable="title"/>
  </macro>

  <macro name="container-title">
    <text variable="container-title" font-weight="bold"/>
  </macro>

  <macro name="edition">
    <choose>
      <if variable="edition">
        <text variable="edition" suffix=". ed."/>
      </if>
    </choose>
  </macro>

  <!-- =========================
       DADOS BIBLIOGRÁFICOS
       ========================= -->

  <macro name="volume">
    <text variable="volume" prefix="v. "/>
  </macro>

  <macro name="issue">
    <text variable="issue" prefix="n. "/>
  </macro>

  <macro name="pages">
    <text variable="page" prefix="p. "/>
  </macro>

  <macro name="publisher">
    <group delimiter=": ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>

  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="date">
    <date variable="issued">
      <date-part name="day" suffix=" "/>
      <date-part name="month" form="short" suffix=" "/>
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="doi">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="DOI: https://doi.org/"/>
      </if>
    </choose>
  </macro>

  <macro name="url">
    <choose>
      <if variable="URL">
        <text variable="URL" prefix="Disponível em: "/>
      </if>
    </choose>
  </macro>

  <macro name="access">
    <choose>
      <if variable="accessed">
        <date variable="accessed" prefix="Acesso em: ">
          <date-part name="day" suffix=" "/>
          <date-part name="month" form="short" suffix=" "/>
          <date-part name="year"/>
        </date>
      </if>
    </choose>
  </macro>

  <!-- =========================
       CITAÇÕES
       ========================= -->

  <citation>
    <layout prefix="(" suffix=")" delimiter="; ">
      <text macro="author-citation"/>
      <date variable="issued" prefix=", ">
        <date-part name="year"/>
      </date>
      <group prefix=", ">
        <label variable="locator" form="short"/>
        <text variable="locator" prefix=" "/>
      </group>
    </layout>
  </citation>

  <!-- =========================
       REFERÊNCIAS
       ========================= -->

  <bibliography hanging-indent="false"
                entry-spacing="1"
                line-spacing="1">

    <sort>
      <key macro="author"/>
      <key variable="issued"/>
      <key variable="title"/>
    </sort>

    <layout suffix=".">

      <!-- ARTIGO DE PERIÓDICO -->
      <choose>
        <if type="article-journal article-magazine article-newspaper" match="any">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title-normal"/>
            <group delimiter=", ">
              <text macro="container-title"/>
              <text macro="volume"/>
              <text macro="issue"/>
              <text macro="pages"/>
              <date variable="issued">
                <date-part name="year"/>
              </date>
            </group>
            <text macro="doi"/>
            <text macro="url"/>
            <text macro="access"/>
          </group>
        </if>

        <!-- LIVRO -->
        <else-if type="book">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title"/>
            <text macro="edition"/>
            <text macro="publisher"/>
            <text macro="year"/>
            <text macro="doi"/>
            <text macro="url"/>
            <text macro="access"/>
          </group>
        </else-if>

        <!-- CAPÍTULO / PARTE DE LIVRO -->
        <else-if type="chapter">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title-normal"/>
            <group>
              <text value="In: " />
              <text macro="editor"/>
              <text variable="container-title" font-weight="bold" prefix=" "/>
            </group>
            <text macro="edition"/>
            <text macro="publisher"/>
            <text macro="year"/>
            <text macro="pages"/>
            <text macro="doi"/>
            <text macro="url"/>
            <text macro="access"/>
          </group>
        </else-if>

        <!-- TESE / DISSERTAÇÃO / TCC -->
        <else-if type="thesis">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title"/>
            <group delimiter=", ">
              <text variable="genre"/>
              <text variable="publisher"/>
              <text variable="publisher-place"/>
              <text macro="year"/>
            </group>
            <text macro="doi"/>
            <text macro="url"/>
            <text macro="access"/>
          </group>
        </else-if>

        <!-- TRABALHO APRESENTADO EM EVENTO -->
        <else-if type="paper-conference">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title-normal"/>
            <group>
              <text variable="event" font-weight="bold"/>
              <text variable="event-place" prefix=", "/>
              <date variable="issued" prefix=", ">
                <date-part name="day" suffix=" "/>
                <date-part name="month" form="short" suffix=" "/>
                <date-part name="year"/>
              </date>
            </group>
            <group>
              <text value="Anais" font-weight="bold"/>
              <text variable="container-title" prefix=". " font-weight="bold"/>
            </group>
            <text macro="publisher"/>
            <text macro="year"/>
            <text macro="pages"/>
            <text macro="doi"/>
            <text macro="url"/>
            <text macro="access"/>
          </group>
        </else-if>

        <!-- RELATÓRIO -->
        <else-if type="report">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title"/>
            <text variable="genre"/>
            <text macro="publisher"/>
            <text macro="year"/>
            <text macro="doi"/>
            <text macro="url"/>
            <text macro="access"/>
          </group>
        </else-if>

        <!-- NORMA / STANDARD -->
        <else-if type="standard">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title"/>
            <text macro="publisher"/>
            <text macro="year"/>
            <text macro="doi"/>
            <text macro="url"/>
            <text macro="access"/>
          </group>
        </else-if>

        <!-- PÁGINA WEB / POST -->
        <else-if type="webpage post-weblog post" match="any">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title"/>
            <text macro="year"/>
            <text macro="url"/>
            <text macro="access"/>
          </group>
        </else-if>

        <!-- GENÉRICO -->
        <else>
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title"/>
            <text macro="container-title"/>
            <text macro="edition"/>
            <text macro="publisher"/>
            <text macro="year"/>
            <text macro="doi"/>
            <text macro="url"/>
            <text macro="access"/>
          </group>
        </else>
      </choose>

    </layout>
  </bibliography>
</style>
