<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="never" default-locale="pt-BR">
  <info>
    <title>ABNT - Customizado (Artigos, Livros e Capítulos)</title>
    <id>http://www.zotero.org/styles/abnt-customizado</id>
    <link href="http://www.zotero.org/styles/abnt-customizado" rel="self"/>
    <author>
      <name>Custom ABNT Style</name>
    </author>
    <category citation-format="author-date"/>
    <category field="generic-base"/>
    <updated>2026-10-03T00:00:00+00:00</updated>
  </info>

  <locale xml:lang="pt-BR">
    <terms>
      <term name="et-al">et al.</term>
      <term name="volume" form="short">v.</term>
      <term name="issue" form="short">n.</term>
      <term name="page" form="short">p.</term>
    </terms>
  </locale>

  <!-- Macro para Autores (Com et al. em itálico para mais de 3 autores) -->
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize-with="." delimiter="; " delimiter-precedes-last="always">
        <name-part name="family" text-case="uppercase"/>
        <name-part name="given"/>
      </name>
      <et-al font-style="italic"/>
      <label form="short" prefix=" (" suffix=")" text-case="capitalize-first"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text variable="title" text-case="uppercase"/>
      </substitute>
    </names>
  </macro>

  <macro name="author-citation">
    <names variable="author">
      <name form="short" name-as-sort-order="all" sort-separator=", " initialize-with="." delimiter="; " delimiter-precedes-last="always">
        <name-part name="family" text-case="uppercase"/>
      </name>
      <et-al font-style="italic"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text variable="title" text-case="uppercase"/>
      </substitute>
    </names>
  </macro>

  <!-- Macro para Título -->
  <macro name="title">
    <choose>
      <type match="any" type="article-journal article-magazine article-newspaper chapter paper-conference">
        <text variable="title"/>
      </type>
      <otherwise>
        <text variable="title" font-weight="bold"/>
      </otherwise>
    </choose>
  </macro>

  <!-- Macro para Container (Revista, Livro de Capítulo, etc.) -->
  <macro name="container-title">
    <choose>
      <type match="any" type="article-journal article-magazine article-newspaper">
        <text variable="container-title" font-weight="bold"/>
      </type>
      <type match="any" type="chapter paper-conference">
        <text variable="container-title" font-weight="bold"/>
      </type>
      <otherwise>
        <text variable="container-title"/>
      </otherwise>
    </choose>
  </macro>

  <!-- Macro de Edição -->
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="numeric"/>
          <text term="edition" form="short" suffix="."/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>

  <!-- Macro de Local e Editora -->
  <macro name="publisher">
    <group delimiter=": ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>

  <!-- Macro para Citação No Texto -->
  <citation et-al-min="4" et-al-use-first="1" disambiguate-add-year-suffix="true" collapse="year">
    <sort>
      <key variable="issued"/>
      <key macro="author"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="author-citation"/>
        <date variable="issued">
          <date-part name="year"/>
        </date>
        <group delimiter=" ">
          <label variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </group>
    </layout>
  </citation>

  <!-- Macro para Bibliografia -->
  <bibliography et-al-min="4" et-al-use-first="1" subsequent-author-substitute="___." entry-spacing="1" line-spacing="1">
    <sort>
      <key macro="author"/>
      <key variable="issued"/>
    </sort>
    <layout suffix=".">
      <text macro="author" suffix=". "/>
      <text macro="title" suffix=". "/>

      <choose>
        <!-- ARTIGOS DE PERIÓDICOS / REVISTAS -->
        <if type="article-journal article-magazine article-newspaper" match="any">
          <group delimiter=", ">
            <text macro="container-title"/>
            <text variable="volume" prefix="v. "/>
            <text variable="issue" prefix="n. "/>
            <text variable="page" prefix="p. "/>
            <date variable="issued">
              <date-part name="year"/>
            </date>
          </group>
        </if>

        <!-- CAPÍTULOS DE LIVROS -->
        <else-if type="chapter paper-conference" match="any">
          <text term="in" text-case="capitalize-first" suffix=": "/>
          <names variable="editor" suffix=". ">
            <name name-as-sort-order="all" sort-separator=", " initialize-with="." delimiter="; "/>
            <label form="short" prefix=" (" suffix=")"/>
          </names>
          <text macro="container-title" suffix=". "/>
          <text macro="edition" suffix=". "/>
          <text macro="publisher" suffix=", "/>
          <date variable="issued" suffix=". ">
            <date-part name="year"/>
          </date>
          <text variable="page" prefix="p. "/>
        </else-if>

        <!-- LIVROS E OUTROS TIPOS -->
        <else>
          <text macro="edition" suffix=". "/>
          <text macro="publisher" suffix=", "/>
          <date variable="issued">
            <date-part name="year"/>
          </date>
          <text variable="page" prefix=". p. "/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
