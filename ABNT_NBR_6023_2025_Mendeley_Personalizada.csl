<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl"
       version="1.0.2"
       class="in-text"
       default-locale="pt-BR"
       demote-non-dropping-particle="never">

  <info>
    <title>ABNT NBR 6023:2025 - personalizada para Mendeley</title>
    <title-short>ABNT 6023:2025 - personalizada</title-short>
    <id>http://www.zotero.org/styles/abnt-6023-2025-mendeley-personalizada</id>
    <link href="https://www.abnt.org.br/" rel="documentation"/>
    <link href="https://csl.mendeley.com/" rel="documentation"/>
    <updated>2026-10-03T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">
      Creative Commons Attribution-ShareAlike 3.0 License
    </rights>
  </info>

  <!--
    ABNT NBR 6023:2025 - configuração personalizada:
    - referências em ordem alfabética;
    - sobrenome em caixa alta;
    - iniciais dos prenomes;
    - título principal destacado em negrito;
    - sem itálico;
    - autores separados por "; ";
    - mais de 3 autores: primeiro autor + "et al.";
    - livros: Autor. Título. Edição. Local: Editora, ano.
    - artigos: Autor. Título do artigo. Periódico, v. X, n. Y, p. X-X, ano.
  -->

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all"
            sort-separator=", "
            initialize-with=". "
            initialize="true"
            delimiter="; "
            delimiter-precedes-last="always"
            text-case="uppercase"/>
      <et-al font-style="normal"/>
    </names>
  </macro>

  <macro name="editor">
    <names variable="editor">
      <name name-as-sort-order="all"
            sort-separator=", "
            initialize-with=". "
            initialize="true"
            delimiter="; "
            delimiter-precedes-last="always"
            text-case="uppercase"/>
      <label form="short" prefix=" (" suffix=".)" text-case="lowercase"/>
    </names>
  </macro>

  <macro name="issued-year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="edition">
    <choose>
      <if variable="edition">
        <text variable="edition" suffix=". ed."/>
      </if>
    </choose>
  </macro>

  <macro name="publisher">
    <group delimiter=": ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>

  <macro name="book-title">
    <text variable="title" font-weight="bold"/>
  </macro>

  <macro name="journal-title">
    <text variable="container-title" font-weight="bold"/>
  </macro>

  <macro name="pages">
    <text variable="page" prefix="p. "/>
  </macro>

  <macro name="volume">
    <text variable="volume" prefix="v. "/>
  </macro>

  <macro name="issue">
    <text variable="issue" prefix="n. "/>
  </macro>

  <macro name="doi-url">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="DOI: https://doi.org/"/>
      </if>
      <else-if variable="URL">
        <group delimiter=". ">
          <text variable="URL" prefix="Disponível em: "/>
          <date variable="accessed" prefix="Acesso em: ">
            <date-part name="day" suffix=" "/>
            <date-part name="month" form="short" suffix=" "/>
            <date-part name="year"/>
          </date>
        </group>
      </else-if>
    </choose>
  </macro>

  <macro name="medium">
    <choose>
      <if variable="medium">
        <text variable="medium"/>
      </if>
      <else-if type="book" variable="URL">
        <text value="E-book"/>
      </else-if>
    </choose>
  </macro>

  <citation>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <names variable="author">
          <name form="short" and="text" delimiter=", " initialize-with=". " text-case="uppercase"/>
          <et-al font-style="normal"/>
        </names>
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </group>
    </layout>
  </citation>

  <bibliography hanging-indent="false"
                entry-spacing="1"
                line-spacing="1">
    <sort>
      <key variable="author"/>
      <key variable="issued"/>
      <key variable="title"/>
    </sort>

    <layout suffix=".">

      <!-- ARTIGO DE PERIÓDICO -->
      <choose>
        <if type="article-journal article-magazine article-newspaper" match="any">
          <group delimiter=". ">
            <text macro="author"/>
            <text variable="title"/>
            <group delimiter=", ">
              <text macro="journal-title"/>
              <text macro="volume"/>
              <text macro="issue"/>
              <text macro="pages"/>
              <text macro="issued-year"/>
            </group>
            <text macro="doi-url"/>
          </group>
        </if>

        <!-- LIVRO -->
        <else-if type="book" match="any">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="book-title"/>
            <text macro="edition"/>
            <text macro="publisher"/>
            <text macro="issued-year"/>
            <text macro="medium"/>
            <text macro="doi-url"/>
          </group>
        </else-if>

        <!-- CAPÍTULO / PARTE DE LIVRO -->
        <else-if type="chapter" match="any">
          <group delimiter=". ">
            <text macro="author"/>
            <text variable="title"/>
            <group delimiter=" ">
              <text value="In:"/>
              <choose>
                <if variable="editor">
                  <text macro="editor"/>
                </if>
                <else>
                  <text variable="container-author"/>
                </else>
              </choose>
            </group>
            <text variable="container-title" font-weight="bold"/>
            <text macro="edition"/>
            <text macro="publisher"/>
            <text macro="issued-year"/>
            <text macro="pages"/>
            <text variable="ISBN" prefix="ISBN "/>
            <text macro="doi-url"/>
          </group>
        </else-if>

        <!-- TESE / DISSERTAÇÃO / TCC -->
        <else-if type="thesis">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="book-title"/>
            <group delimiter=": ">
              <text variable="genre"/>
              <text variable="publisher"/>
            </group>
            <text variable="publisher-place"/>
            <text macro="issued-year"/>
            <text macro="doi-url"/>
          </group>
        </else-if>

        <!-- EVENTO / TRABALHO EM EVENTO -->
        <else-if type="paper-conference">
          <group delimiter=". ">
            <text macro="author"/>
            <text variable="title"/>
            <text variable="event" font-weight="bold"/>
            <group delimiter=", ">
              <text variable="publisher-place"/>
              <text macro="issued-year"/>
            </group>
            <text macro="publisher"/>
            <text macro="pages"/>
            <text macro="doi-url"/>
          </group>
        </else-if>

        <!-- PADRÃO PARA OUTROS TIPOS -->
        <else>
          <group delimiter=". ">
            <text macro="author"/>
            <text variable="title" font-weight="bold"/>
            <text macro="publisher"/>
            <text macro="issued-year"/>
            <text macro="doi-url"/>
          </group>
        </else>
      </choose>

    </layout>
  </bibliography>
</style>
